# Reverse gitignore - explicitly include files
*
!*/
!/.gitignore
!/.gitattributes
!/.editorconfig

# Github and build script
!/.github/**/*.md
!/.github/**/*.yml
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties
!/src/**

# Port verification source (no downloaded binaries or diagnostic outputs)
!/tools/porting/*.py
!/tools/porting/*.java
!/tools/porting/*.json
!/tools/porting/*.gradle

# Resource generation
!/resources/**/*.py
!/resources/**/*.bbmodel
!/resources/texture_templates/**/*.png
!/resources/structure_templates/**/*.nbt
!/resources/lang/**/*.json
!/resources/requirements.txt
!/resources/bsc5p_radec_min.json

# Metadata
!/build.gradle.kts
!/settings.gradle.kts
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/LICENSE.txt
!/HEADER.txt
!/README.md
!/CHANGELOG.md
!/PROJECT_STATUS.md
!/docs/foundations/**/*.md
!/CodeStyle.xml

# Splash / Logo Images
!/img/**/*.png
!/img/**/*.gif

# Other exclusions
__pycache__/
*.pyc
*.pdn
.DS_Store
/.vscode/

/run/
/out/
/build/
/venv/
/.idea/
/src/generated/resources/.cache/**
